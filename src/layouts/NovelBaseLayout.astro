---
// 小説本文用レイアウトページ
import type { MarkdownInstance } from "astro"
import Layout from "./Layout.astro"
import ReturnTop from "../components/ReturnTop.astro"
import PageNav from "../components/PageNav.astro"

const { frontmatter, file } = Astro.props
const series = frontmatter.series
const title = frontmatter.title

// src/pages以下のmdをすべて読み込む
const allPages = Object.values(
  import.meta.glob<MarkdownInstance<Record<string, any>>>(
    "../pages/**/*.md",
    { eager: true }
  )
)

// 同じseriesのmdをファイル名順に並べ、自分の前後を取り出す
const siblings = series
  ? allPages
      .filter((p) => p.frontmatter.series === series)
      .sort((a, b) => a.file.localeCompare(b.file, undefined, { numeric: true }))
  : []
const index = siblings.findIndex((p) => p.file === file)

const back = siblings[index - 1]?.url ?? null
const next = siblings[index + 1]?.url ?? null
const top = series ? `/${series}/` : null
---

<Layout title={title}>
  <h2>
    {title}
  </h2>
  <div class="novel-nav">
    <ReturnTop series={series} title={title} top={top} />
    <PageNav back={back} next={next} />
  </div>
  <hr />
  <div class="novel-content">
    <slot />
  </div>
  <hr />
  <div class="novel-nav">
    <PageNav back={back} next={next} />
    <ReturnTop series={series} title={title} top={top} />
  </div>
</Layout>

<style>
  h2 {
    margin: 9px 0 0;
    padding: 2px 8px;
    color: #fff;
    background-color: #666;
    font-weight: bold;
    letter-spacing: 2px;
  }

  hr {
    border: 0;
    height: 1px;
    background-image: -webkit-linear-gradient(left, #f0f0f0, #8c8b8b, #f0f0f0);
    background-image: -moz-linear-gradient(left, #f0f0f0, #8c8b8b, #f0f0f0);
    background-image: -ms-linear-gradient(left, #f0f0f0, #8c8b8b, #f0f0f0);
    background-image: -o-linear-gradient(left, #f0f0f0, #8c8b8b, #f0f0f0);
  }

  .novel-nav {
    text-align: right;
    margin: 5px 0;
  }

  .return-top {
    margin: 2px 0;
  }

  .novel-content {
    margin: 30px 0;
    line-height: 180%;
  }
</style>
