---
//Content Collections（src/content/novels）のエントリ用レイアウトページ
import type { CollectionEntry } from "astro:content"
import { getCollection, render } from "astro:content"
import Layout from "./Layout.astro"
import ReturnTop from "../components/ReturnTop.astro"
import PageNav from "../components/PageNav.astro"

export interface Props {
  entry: CollectionEntry<"novels">
}

const { entry } = Astro.props
const { series, title } = entry.data
// back/nextで行き来できる範囲
// 省略時は本編と同じように全ページがback/nextで行き来できる
const group = entry.data.group ?? series

const allEntries = await getCollection("novels")
const siblings = allEntries
  .filter((e) => (e.data.group ?? e.data.series) === group)
  .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }))

const index = siblings.findIndex((e) => e.id === entry.id)
const back = siblings[index - 1] ? `/${siblings[index - 1].id}` : null
const next = siblings[index + 1] ? `/${siblings[index + 1].id}` : null
const top = `/${series}/`

const { Content } = await render(entry)
---

<Layout title={title}>
  <h2>
    {title}
  </h2>
  <div class="novel-nav">
    <ReturnTop series={series} title={title} top={top} />
    <PageNav back={back} next={next} />
  </div>
  <hr />
  <div class="novel-content">
    <Content />
  </div>
  <hr />
  <div class="novel-nav">
    <PageNav back={back} next={next} />
    <ReturnTop series={series} title={title} top={top} />
  </div>
</Layout>

<style>
  h2 {
    margin: 9px 0 0;
    padding: 2px 8px;
    color: #fff;
    background-color: #666;
    font-weight: bold;
    letter-spacing: 2px;
  }

  hr {
    border: 0;
    height: 1px;
    background-image: -webkit-linear-gradient(left, #f0f0f0, #8c8b8b, #f0f0f0);
    background-image: -moz-linear-gradient(left, #f0f0f0, #8c8b8b, #f0f0f0);
    background-image: -ms-linear-gradient(left, #f0f0f0, #8c8b8b, #f0f0f0);
    background-image: -o-linear-gradient(left, #f0f0f0, #8c8b8b, #f0f0f0);
  }

  .novel-nav {
    text-align: right;
    margin: 5px 0;
  }

  .return-top {
    margin: 2px 0;
  }

  .novel-content {
    margin: 30px 0;
    line-height: 180%;
  }
</style>
