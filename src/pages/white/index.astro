---
import Layout from "../../layouts/Layout.astro"
import ImageCut from "../../components/NovelImageCut.astro"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"

const title = "眠りの白に導かれ"
const tabTitle = title + " - Top"

type Entry = CollectionEntry<"novels">

// 各ページをフォルダ・ファイルの並び順と同じに揃える
const allEntries = (
  await getCollection("novels", (e) => e.data.series === "white")
).sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }))

const pageNumber = (entry: Entry) => entry.id.match(/(\d+)$/)?.[1] ?? ""

const mainEntries = allEntries.filter((e) => !e.id.includes("/extra/"))
const extraEntries = allEntries.filter((e) => e.id.includes("/extra/"))

// chapterが同じページを1つの章としてまとめる
const mainChapters: { heading: string; entries: Entry[] }[] = []
for (const entry of mainEntries) {
  const heading = entry.data.chapter ?? ""
  const current = mainChapters[mainChapters.length - 1]
  if (current?.heading === heading) {
    current.entries.push(entry)
  } else {
    mainChapters.push({ heading, entries: [entry] })
  }
}

// 同じgroupのページをまとめて1話にする
type Episode = { label: string; description?: string | null; entries: Entry[] }
const extraEpisodeMap = new Map<string, Episode>()
for (const entry of extraEntries) {
  const group = entry.data.group ?? entry.id
  const episode = extraEpisodeMap.get(group)
  if (episode) {
    episode.entries.push(entry)
  } else {
    extraEpisodeMap.set(group, {
      label: entry.data.label ?? entry.data.title,
      description: entry.data.description,
      entries: [entry],
    })
  }
}
const extraEpisodes = [...extraEpisodeMap.values()]
---

<Layout title={tabTitle}>
  <ImageCut src="/cut/white.jpg" />
  <h2>{title}</h2>
  <p>
    唯一の肉親であった兄を戦争によって亡くした少女エルセは、幼なじみのターキィのもとへ身を寄せる。<br
    />
    しかし、平穏だと思われた日常は徐々に姿を変えていく。ある日、エルセはまるで何かに導かれるように、兄の命を奪った敵国トロイラへ向かうことになる。
  </p>
  <p>
    そこで待ち受けていたのは、遠い昔から眠り続けてきた、一つの意思だった――。
  </p>

  <h3>本編目次</h3>
  {
    mainChapters.map((chapter) => (
      <Fragment>
        <h4>{chapter.heading}</h4>
        <div class="page-links">
          {chapter.entries.map((entry) => (
            <a href={`/${entry.id}`}>{pageNumber(entry)}</a>
          ))}
        </div>
      </Fragment>
    ))
  }

  <h3>番外編</h3>
  {
    extraEpisodes.map((episode) =>
      episode.entries.length > 1 ? (
        <Fragment>
          <h4>{episode.label}</h4>
          <div class="page-links">
            {episode.entries.map((entry) => (
              <a href={`/${entry.id}`}>{pageNumber(entry)}</a>
            ))}
          </div>
          <p>{episode.description}</p>
        </Fragment>
      ) : (
        <div class="extra-entry">
          <a href={`/${episode.entries[0].id}`}>{episode.label}</a>／{episode.description}
        </div>
      )
    )
  }
</Layout>

<style>
  h2 {
    margin: 9px 0 0;
    padding: 2px 8px;
    color: #fff;
    background-color: #666;
    font-weight: bold;
    letter-spacing: 2px;
  }

  h3 {
    border-left: 3px double;
    padding-left: 10px;
    margin-bottom: 8px;
  }

  h4 {
    margin-top: 20px;
    border-bottom: 1px dotted #000;
  }

  .page-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
  }

  .extra-entry {
    margin: 4px 0;
  }
</style>
