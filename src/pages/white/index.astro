---
import Layout from "../../layouts/Layout.astro"
import ImageCut from "../../components/NovelImageCut.astro"
import PageLinks from "../../components/novel/PageLinks.astro"
import StoryCard from "../../components/novel/StoryCard.astro"

const title = "眠りの白に導かれ"
const tabTitle = title + " - Top"
---

<Layout title={tabTitle}>
  <ImageCut src="/cut/white.jpg" />
  <h2>{title}</h2>
  <p>
    唯一の肉親であった兄を戦争によって亡くした少女エルセは、幼なじみのターキィのもとへ身を寄せる。<br
    />
    しかし、平穏だと思われた日常は徐々に姿を変えていく。ある日、エルセはまるで何かに導かれるように、兄の命を奪った敵国トロイラへ向かうことになる。
  </p>
  <p>
    そこで待ち受けていたのは、遠い昔から眠り続けてきた、一つの意思だった――。
  </p>

  <h3>本編目次</h3>
  <PageLinks folder="white/main/0" heading="序章「月の下で」" />
  <PageLinks folder="white/main/1" heading="１章「始動」" />
  <PageLinks folder="white/main/2" heading="２章「忍び寄る者」" />
  <PageLinks folder="white/main/2i" heading="幕間　ディルケス" />
  <PageLinks folder="white/main/3" heading="３章「夢幻の狭間で」" />
  <PageLinks folder="white/main/4" heading="４章「交差と翻弄」" />
  <PageLinks folder="white/main/4i" heading="幕間　ミュゼ" />
  <PageLinks folder="white/main/5" heading="５章「祈りの向かうその先へ」" />
  <PageLinks folder="white/main/6" heading="６章「追想」" />
  <PageLinks folder="white/main/6i" heading="幕間　イアトス" />
  <PageLinks folder="white/main/7" heading="７章「憧憬の果て」" />
  <PageLinks folder="white/main/7i" heading="幕間　リオット" />
  <PageLinks folder="white/main/8" heading="８章「眠りの白に導かれ」" />
  <PageLinks folder="white/main/9" heading="終章「繰り返される物語」" />

  <h3>番外編</h3>
  <StoryCard
    page="white/extra/1-tooki-hini-siro-wa-izanau"
    title="遠き日に、白はいざなう"
    description="ウェルバーニアとフーリエスの約束"
  />
</Layout>

<style>
  h2 {
    margin: 9px 0 0;
    padding: 2px 8px;
    color: #fff;
    background-color: #666;
    font-weight: bold;
    letter-spacing: 2px;
  }

  h3 {
    border-left: 3px double;
    padding-left: 10px;
    margin-bottom: 8px;
  }
</style>
