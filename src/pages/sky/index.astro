---
import Layout from "../../layouts/Layout.astro"
import ImageCut from "../../components/NovelImageCut.astro"
import PageLinks from "../../components/novel/PageLinks.astro"

const title = "空の揺動"
const tabTitle = title + " - Top"
---

<Layout title={tabTitle}>
  <ImageCut src="/cut/sky.jpg" />
  <h2>{title}</h2>
  <p>
    不遇の事故により津川家に居候している村井正己は、ある日、主人に縁談が持ち上がっていることを知る。<br
    />
    相手の女性は洋服を着こなす、色白で綺麗な女性だった。
  </p>
  <p>
  原稿用紙61枚／完結
  </p>
  <h3>本編目次</h3>
  <PageLinks folder="sky/main" label="title" />
</Layout>

<style>
  h2 {
    margin: 9px 0 0;
    padding: 2px 8px;
    color: #fff;
    background-color: #666;
    font-weight: bold;
    letter-spacing: 2px;
  }

  h3 {
    border-left: 3px double;
    padding-left: 10px;
    margin-bottom: 8px;
  }
</style>
