---
export interface Props {
  back: string | null
  next: string | null
}

const { back, next } = Astro.props

const backText: string = "ＢＡＣＫ"
const nextText: string = "ＮＥＸＴ"
---

<div class="page-nav">
  {back ? <a href={back}>{backText}</a> : <span />}
  {back || next ? <span>&nbsp;|&nbsp;</span> : <span />}
  {next ? <a href={next}>{nextText}</a> : <span />}
</div>

<style>
  .page-nav {
    margin: 3px 0;
  }
</style>
