---
export interface Props {
  series: string
  title: string
}

const { series, title, top } = Astro.props
---

{
  series !== null ? (
    <div class="return-top">
      {top !== null ? <a href={top}>作品ＴＯＰ</a> : <a href="../">作品ＴＯＰ</a>}
    </div>
  ) : (
    <div class="return-top">
      <a href="/">ＩＮＤＥＸ</a>&nbsp;＞&nbsp;{title}
    </div>
  )
}

<style>
  .page-nav {
    margin: 3px 0;
  }
</style>
