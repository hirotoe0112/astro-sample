---
export interface Props {
  series: string
  title: string
  top: string | undefined
}

const { series, title, top } = Astro.props
const pathToTop = top ? top : "../"
---

{
  series !== null ? (
    <div class="return-top">
      {<a href={pathToTop}>作品ＴＯＰ</a>}
    </div>
  ) : (
    <div class="return-top">
      <a href="/">ＩＮＤＥＸ</a>&nbsp;＞&nbsp;{title}
    </div>
  )
}

<style>
  .page-nav {
    margin: 3px 0;
  }
</style>
